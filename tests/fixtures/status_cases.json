  "run_status": [
    {
      "name": "run_start only is running",
      "events": [
        {
          "kind": "run_start",
          "step_key": "",
          "run_id": "r1",
          "status": "running"
        }
      ],
      "expected": {
        "r1": "running"
      }
    },
    {
      "name": "started step keeps run running",
      "events": [
        {
          "kind": "step_start",
          "step_key": "a",
          "run_id": "r1",
          "status": "running"
        }
      ],
      "expected": {
        "r1": "running"
      }
    },
    {
      "name": "all steps stopped finishes run",
      "events": [
        {
          "kind": "step_start",
          "step_key": "a",
          "run_id": "r1",
          "status": "running"
        },
        {
          "kind": "step_stop",
          "step_key": "a",
          "run_id": "r1",
          "status": "pass"
        }
      ],
      "expected": {
        "r1": "finished"
      }
    },
    {
      "name": "one unstopped step keeps run running",
      "events": [
        {
          "kind": "step_start",
          "step_key": "a",
          "run_id": "r1",
          "status": "running"
        },
        {
          "kind": "step_start",
          "step_key": "b",
          "run_id": "r1",
          "status": "running"
