          "kind": "step_start",
          "step_key": "a",
          "run_id": "r1",
          "status": "running"
        },
        {
          "kind": "run_stop",
          "step_key": "",
          "run_id": "r1",
          "status": "pass"
        }
      ],
      "expected": {
        "r1": "finished"
      }
    },
    {
      "name": "new start reopens finished run",
      "events": [
        {
          "kind": "step_start",
          "step_key": "a",
          "run_id": "r1",
          "status": "running"
        },
        {
          "kind": "step_stop",
          "step_key": "a",
          "run_id": "r1",
          "status": "pass"
        },
